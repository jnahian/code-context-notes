---
// Stats band + final call to action
import InstallButton from './InstallButton.astro';
---
<section style="background:radial-gradient(800px 400px at 50% 120%, #16233b 0%, #0B1220 60%);padding:88px 32px;">
  <div style="max-width:1000px;margin:0 auto;">
    <div data-reveal class="dc-grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center;padding-bottom:64px;border-bottom:1px solid #182234;">
      <div><div style="font:700 40px 'Space Grotesk';color:#FF8A3D;">446</div><div style="font:500 13px 'IBM Plex Mono';color:#8A93A6;margin-top:4px;">tests</div></div>
      <div><div style="font:700 40px 'Space Grotesk';color:#FF8A3D;">88%</div><div style="font:500 13px 'IBM Plex Mono';color:#8A93A6;margin-top:4px;">test coverage</div></div>
      <div><div style="font:700 40px 'Space Grotesk';color:#FF8A3D;">0</div><div style="font:500 13px 'IBM Plex Mono';color:#8A93A6;margin-top:4px;">source lines touched</div></div>
      <div><div style="font:700 40px 'Space Grotesk';color:#FF8A3D;">MIT</div><div style="font:500 13px 'IBM Plex Mono';color:#8A93A6;margin-top:4px;">open source</div></div>
    </div>
    <div data-reveal style="text-align:center;padding-top:64px;">
      <h2 style="margin:0;font:700 48px/1.08 'Space Grotesk';color:#F4F1E9;letter-spacing:-.02em;">Give your agents the context<br />they've been missing.</h2>
      <p style="margin:18px auto 0;max-width:460px;font:400 17px/1.6 'IBM Plex Sans';color:#9BA3B4;">Free, open source, MCP-native. Optimized context that lives with your code, not in a prompt.</p>
      <div style="display:flex;gap:14px;justify-content:center;margin-top:30px;flex-wrap:wrap;align-items:center;">
        <InstallButton label="Add to VS Code" size="lg" />
        <a href="/docs" style="font:600 16px 'IBM Plex Sans';color:#F4F1E9;border:1px solid #33405a;padding:14px 27px;border-radius:11px;">Read the docs</a>
      </div>
    </div>
  </div>
</section>
