# Source files
src/**
tsconfig.json
esbuild.config.js

# Test files
out/test/**
out/**/*.map
out/**/*.js.map

# We ship the bundled extension.js only — exclude every other compiled module
out/**/*.js
!out/extension.js

# Test files
.nyc_output/**
coverage/**

# Include only production dependencies, exclude devDependencies
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/*.md
node_modules/**/.npmignore
node_modules/**/.eslintrc*
node_modules/**/tsconfig.json
node_modules/**/@types/**
node_modules/prettier/**

# Development files
.claude/**
.superpowers/**
packages/**
CLAUDE.md
NEXT_STEPS.md
PROJECT_COMPLETE.md
scripts/**

# Web and app directories (not part of VSCode extension)
web/**
app/**

# Documentation
docs

# Git files
.gitignore
.github

# Build artifacts
*.vsix

# Environment files
.env

# Unused images
images/logo.png
images/README.md
images/screenshot-*.jpg

# local notes
.code-notes